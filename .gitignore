# Data — never commit subject data
data/*
!data/.gitkeep

# Project index files — derived from data, not source
projects/*/index/*
!projects/*/index/.gitkeep

# Calibration data — never commit subject or lab calibration files
calibration/data/transducer/
calibration/data/probe_checks/records/
calibration/data/probe_checks/references/

# Keep folder structure but not contents
!calibration/data/transducer/.gitkeep
!calibration/data/probe_checks/records/.gitkeep
!calibration/data/probe_checks/references/.gitkeep

# Test artifacts
tests/tmp/

# Config backup files created during tests
config/system_config_backup.mat

# MATLAB generated files
*.asv          # autosave files
*.m~           # backup files
*.mlapp~       # App Designer backups

# TDT circuit compiled files (keep .rcx.bak if generated)
hardware/circuits/*.rcx.bak

# OS files
.DS_Store
Thumbs.db